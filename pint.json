{
    "preset": "laravel",
    "rules": {
        "single_quote": true,
        "ordered_imports": true,
        "array_syntax": {
            "syntax": "short"
        },
        "no_unused_imports": true,
        "phpdoc_no_package": true,
        "phpdoc_order": true,
        "no_superfluous_phpdoc_tags": true
    },
    "exclude": [
        "vendor",
        "storage",
        "bootstrap/cache"
    ]
}